# Copy to .env (never commit .env).
# docker compose reads this file; for local development put it in backend/.env instead.

# REQUIRED in production: a long random string. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional: a free key from https://console.groq.com/keys turns on the AI features.
GROQ_API_KEY=

# Optional: the Postgres password used by docker compose.
POSTGRES_PASSWORD=spendwise

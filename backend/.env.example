# Local development settings. Copy this file to .env in this folder (never commit .env).
# Every line is optional: with no .env at all, SpendWise runs on SQLite with the AI switched off.

# Free key from https://console.groq.com/keys (starts with gsk_). It turns on the AI features.
GROQ_API_KEY=

# Where the data lives. The default is a SQLite file next to this one.
# DATABASE_URL=sqlite:///./spendwise.db
# DATABASE_URL=postgresql+psycopg://spendwise:spendwise@127.0.0.1:5433/spendwise

# Set this to keep people logged in across restarts (32+ random characters).
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
